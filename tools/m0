#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
fixture="$root/tests/fixtures/m0-radv-compute"
cmd=${1:-help}
shift || true
case "$cmd" in
preflight|package)
    : "${TEMPLATE:?PS5_VulkanTemplate checkout}" "${VULKAN:?built PS5_Vulkan checkout}" "${MESA:?PS5_Mesa checkout}"
    : "${TITLE_SDK:?template SDK installation}" "${ARCHIVE_SDK:?RADV SDK installation}" "${RADV:?verified RADV release directory}" "${SDK_SOURCE:?PS5_PayloadSDK checkout}"
    for tool in python3 git cmake ninja clang ld.lld llvm-nm glslangValidator spirv-val rg readelf sha256sum; do
        command -v "$tool" >/dev/null || { echo "missing tool: $tool" >&2; exit 1; }
    done
    python3 -c 'from PIL import Image, ImageDraw, ImageFont; from hashlib import file_digest'
    for file in "$VULKAN/build/host/ps5-native-tool" "$VULKAN/runtime/libc.prx" "$TEMPLATE/ps5/tools/link-title.sh" \
        "$RADV/lib/libvulkan_radeon.ps5.a" "$TITLE_SDK/bin/prospero-lld" "$ARCHIVE_SDK/bin/prospero-clang++" \
        /usr/share/doc/{libllvm21,fonts-dejavu-core}/copyright; do test -r "$file" || { echo "missing $file" >&2; exit 1; }; done
    python3 "$root/tools/m0-accept.py" inputs
    [[ "$cmd" == preflight ]] && exit 0
    out=$(realpath -m "${1:?provide a fresh output directory}")
    mkdir -p "$(dirname "$out")"
    mkdir "$out"
    bash "$fixture/cross-check.sh" "$out/cross" "$ARCHIVE_SDK" "$RADV" --timing
    python3 "$root/tools/build-m0-title.py" "$out/title" "$TEMPLATE" "$VULKAN" "$MESA" "$TITLE_SDK" "$RADV" "$out/cross" "$SDK_SOURCE"
    python3 "$root/tools/m0-accept.py" package "$out/title/dist/PPSA99743"
    ;;
linux)
    out=${1:?provide a build directory}; shift
    capture=()
    if [[ -n ${TEMPLATE:-} ]]; then capture+=("-DM0_TEMPLATE_SRC=$TEMPLATE"); fi
    cmake -S "$fixture" -B "$out" -G Ninja -DCMAKE_BUILD_TYPE=Release "${capture[@]}" "$@"
    cmake --build "$out"
    ctest --test-dir "$out" --output-on-failure
    ;;
verify|accept)
    mode=package; [[ "$cmd" == accept ]] && mode=run
    exec python3 "$root/tools/m0-accept.py" "$mode" "$@"
    ;;
deploy|readback|retrieve)
    exec python3 "$root/tools/m0-transfer.py" "$cmd" "$@"
    ;;
*) echo "Usage: tools/m0 preflight | linux OUT [CMAKE_ARGS...] | package NEW_OUT | verify FOLDER | accept FOLDER RUN | deploy FOLDER HOST | readback FOLDER HOST | retrieve HOST RUN NEW_OUT" >&2; exit 2 ;;
esac
