#version 450

layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) writeonly buffer Results {
    uint words[];
} output_data;

void main() {
    uint index = gl_GlobalInvocationID.x;
    output_data.words[index] = index * 3u + 7u;
}
